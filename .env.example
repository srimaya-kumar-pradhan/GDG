# .env.example — Copy to .env, fill values. NEVER commit .env
# ─────────────────────────────────────────────
# Google AI
GEMINI_API_KEY=your_google_ai_studio_key_here

# Firebase
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebasedatabase.app
FIREBASE_CREDENTIALS_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=backend/serviceAccountKey.json

# Security
ADMIN_KEY=your_secure_admin_key_here

# App
APP_ENV=production
PORT=8080
