# ─────────────────────────────────────────────
# VenueFlow AI — Environment Configuration Template
# SECURITY: Copy this file to .env and fill in your real values.
#           NEVER commit .env to version control!
# ─────────────────────────────────────────────

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebasedatabase.app/

# Firebase Credentials — choose ONE method:
# Method 1: Local development (file path)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/your-service-account.json
# Method 2: Cloud deployment (paste full JSON string)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Admin API Key (for protected endpoints — set a strong random value in production)
ADMIN_KEY=change-this-to-a-secure-key

# App Environment (development | production)
APP_ENV=development
